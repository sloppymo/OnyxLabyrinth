{
  "name": "wizardry-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.tools.json && vite build",
    "check:tools": "tsc -p tsconfig.tools.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run test:typecheck && npm run build && npm test && npm run floor:validate && npm run floor:export-check",
    "floor:validate": "tsx scripts/floor-tool.ts validate",
    "floor:dump": "tsx scripts/floor-tool.ts dump",
    "floor:export-all": "tsx scripts/floor-tool.ts export-all && mkdir -p public/tools && rm -rf public/tools/floor-data && cp -r tools/floor-data public/tools/floor-data",
    "floor:export-check": "tsx scripts/floor-tool.ts export-check",
    "floor:check": "tsx scripts/floor-tool.ts check",
    "floor:editor": "vite --open /tools/floor-editor.html",
    "sprite-preview:generate": "tsx scripts/generate-sprite-preview.ts",
    "barks:audit": "tsx scripts/audit-combat-barks.ts",
    "barks:preview": "tsx scripts/generate-combat-bark-preview.ts",
    "playtest:combat-barks": "tsx scripts/playtests/combat-bark-exposure-2026-08-15.ts",
    "generate:combat-bg": "node scripts/generate-combat-bg.mjs",
    "wall:generate": "node scripts/generate-wall-variants.mjs",
    "wall:validate": "node scripts/validate-wall-families.mjs",
    "wall:qa": "node scripts/playtests/wall-family-art-qa.mjs",
    "tileset:gallery": "node scripts/generate-tileset-gallery.mjs",
    "visual:floors": "node scripts/playtests/floor-visual-audit.mjs",
    "test:lighting": "tsx scripts/playtests/lighting-suite.ts",
    "benchmark:maze": "node scripts/playtests/maze-renderer-benchmark.mjs",
    "playtest:maze-heights": "node scripts/playtests/maze-height-demo.mjs",
    "playtest:maze-vertical": "node scripts/playtests/maze-vertical-traversal.mjs",
    "playtest:maze-vertical-gate4": "node scripts/playtests/maze-vertical-gate4.mjs",
    "playtest:maze-lifecycle": "node scripts/playtests/maze-renderer-lifecycle.mjs",
    "playtest:hubs": "node scripts/playtests/hub-walkthrough.mjs",
    "sprite-preview:serve": "python3 -m http.server 8080",
    "sprite-preview": "npm run sprite-preview:generate && echo 'Open sprite-preview.html in your browser (or run npm run sprite-preview:serve).'",
    "replay": "node scripts/replays/replay.mjs",
    "replay:record": "node scripts/replays/record.mjs",
    "card-trial:playtest": "node scripts/playtests/card-trial-playtest-server.mjs",
    "card-trial:summary": "node scripts/playtests/card-trial-session-summary.mjs",
    "card-trial:aggregate": "node scripts/playtests/card-trial-aggregate.mjs",
    "card-trial:bundle": "node scripts/playtests/card-trial-bundle.mjs",
    "card-trial:replay": "node scripts/playtests/card-trial-replay.mjs",
    "card-trial:fuzz": "node scripts/playtests/card-trial-fuzz.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "three": "^0.185.1"
  }
}
